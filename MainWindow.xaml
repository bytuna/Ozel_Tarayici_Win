<Window x:Class="OzelTarayici.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Özel Tarayıcı"
        Width="1440"
        Height="920"
        MinWidth="920"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Icon="icon.ico"
        Background="{DynamicResource AppBgBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">

    <Window.Resources>
        <SolidColorBrush x:Key="AppBgBrush" Color="#121214"/>
        <SolidColorBrush x:Key="BarBgBrush" Color="#18181B"/>
        <SolidColorBrush x:Key="SurfaceBgBrush" Color="#242429"/>
        <SolidColorBrush x:Key="HoverBgBrush" Color="#34343D"/>
        <SolidColorBrush x:Key="BorderBrushSubtle" Color="#2E2E36"/>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F4F4F5"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#A1A1AA"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#00B37E"/>
        <SolidColorBrush x:Key="ClockDisplayBgBrush" Color="#050608"/>
        <SolidColorBrush x:Key="ClockLedBrush" Color="#00FFAA"/>
        <Color x:Key="ClockLedColor">#00FFAA</Color>

        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="IconToolButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBgBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PillActionButton" TargetType="Button" BasedOn="{StaticResource IconToolButton}">
            <Setter Property="Background" Value="{DynamicResource SurfaceBgBrush}"/>
            <Setter Property="Padding" Value="10,5"/>
        </Style>

        <Style x:Key="GradientIconButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.86"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.72"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DashboardCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource BarBgBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushSubtle}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="16"/>
        </Style>

        <Style x:Key="PrayerChip" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceBgBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushSubtle}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Margin" Value="3"/>
        </Style>

        <!-- Flu Yer Tutucu (Placeholder) TextBox Stili -->
        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <ScrollViewer x:Name="PART_ContentHost"
                                              Focusable="False"
                                              Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                                              VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}"/>
                                <TextBlock x:Name="WatermarkText"
                                           Text="{TemplateBinding Tag}"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Opacity="0.5"
                                           Margin="{TemplateBinding Padding}"
                                           VerticalAlignment="Center"
                                           IsHitTestVisible="False"
                                           Visibility="Collapsed"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="Text" Value=""/>
                                    <Condition Property="IsKeyboardFocused" Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="WatermarkText" Property="Visibility" Value="Visible"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Arama Önerileri Seçim Vurgusu Stili -->
        <Style x:Key="SuggestionListBoxItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="Margin" Value="2,1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBgBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Canlı 3 Çubuklu Ekolayzır Butonu -->
        <Style x:Key="EqualizerButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ToolTip" Value="Videoyu Durdur / Başlat"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Height="12">
                                <Rectangle Width="2.5" Height="10" RadiusX="1" RadiusY="1" Fill="{DynamicResource AccentBrush}" Margin="0,0,1.5,0" VerticalAlignment="Bottom" RenderTransformOrigin="0.5,1">
                                    <Rectangle.RenderTransform>
                                        <ScaleTransform ScaleY="0.4"/>
                                    </Rectangle.RenderTransform>
                                    <Rectangle.Triggers>
                                        <EventTrigger RoutedEvent="Loaded">
                                            <BeginStoryboard x:Name="EqBar1">
                                                <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" From="0.25" To="1.0" Duration="0:0:0.36"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                        <EventTrigger RoutedEvent="Unloaded">
                                            <StopStoryboard BeginStoryboardName="EqBar1"/>
                                        </EventTrigger>
                                    </Rectangle.Triggers>
                                </Rectangle>
                                <Rectangle Width="2.5" Height="12" RadiusX="1" RadiusY="1" Fill="{DynamicResource AccentBrush}" Margin="0,0,1.5,0" VerticalAlignment="Bottom" RenderTransformOrigin="0.5,1">
                                    <Rectangle.RenderTransform>
                                        <ScaleTransform ScaleY="0.9"/>
                                    </Rectangle.RenderTransform>
                                    <Rectangle.Triggers>
                                        <EventTrigger RoutedEvent="Loaded">
                                            <BeginStoryboard x:Name="EqBar2">
                                                <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" From="1.0" To="0.3" Duration="0:0:0.48"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                        <EventTrigger RoutedEvent="Unloaded">
                                            <StopStoryboard BeginStoryboardName="EqBar2"/>
                                        </EventTrigger>
                                    </Rectangle.Triggers>
                                </Rectangle>
                                <Rectangle Width="2.5" Height="9" RadiusX="1" RadiusY="1" Fill="{DynamicResource AccentBrush}" VerticalAlignment="Bottom" RenderTransformOrigin="0.5,1">
                                    <Rectangle.RenderTransform>
                                        <ScaleTransform ScaleY="0.6"/>
                                    </Rectangle.RenderTransform>
                                    <Rectangle.Triggers>
                                        <EventTrigger RoutedEvent="Loaded">
                                            <BeginStoryboard x:Name="EqBar3">
                                                <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" From="0.35" To="0.95" Duration="0:0:0.41"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                        <EventTrigger RoutedEvent="Unloaded">
                                            <StopStoryboard BeginStoryboardName="EqBar3"/>
                                        </EventTrigger>
                                    </Rectangle.Triggers>
                                </Rectangle>
                            </StackPanel>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="42"/>
            <RowDefinition Height="46"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 1. KATMAN: NATIVE SEKME VE GRUP ÇUBUĞU -->
        <Border Grid.Row="0" Background="{DynamicResource AppBgBrush}" BorderBrush="{DynamicResource BorderBrushSubtle}" BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="True" Margin="6,4,6,0">
                <Button DockPanel.Dock="Right" x:Name="BtnCreateGroup" Style="{StaticResource PillActionButton}" Content="➕ Grup" ToolTip="Yeni Çalışma Grubu Oluştur" Margin="4,0,2,4" Click="BtnCreateGroup_Click"/>

                <ScrollViewer x:Name="TabsScrollViewer" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" PreviewMouseWheel="TabsScrollViewer_PreviewMouseWheel">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                        <!-- Çalışma Grupları ve Kendi Sekmeleri Yan Yana -->
                        <ItemsControl x:Name="GroupsItemsControl" VerticalAlignment="Bottom">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,2,6,0" CornerRadius="8,8,0,0" Padding="3,2,3,0">
                                        <Border.Background>
                                            <SolidColorBrush Color="{Binding ColorHex}" Opacity="0.10"/>
                                        </Border.Background>
                                        <Border.BorderBrush>
                                            <SolidColorBrush Color="{Binding ColorHex}"/>
                                        </Border.BorderBrush>
                                        <Border.BorderThickness>0,2,0,0</Border.BorderThickness>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                                            <!-- Grup Kapsülü -->
                                            <Border CornerRadius="10" Padding="8,3" Margin="2,0,4,4" Cursor="Hand"
                                                    VerticalAlignment="Center"
                                                    AllowDrop="True"
                                                    DragOver="GroupPill_DragOver"
                                                    Drop="GroupPill_Drop"
                                                    MouseLeftButtonDown="GroupPill_Click" Tag="{Binding}"
                                                    ToolTip="Tıkla: Grubu Katla/Aç | Sekme Sürükle: Gruba Al | Sağ Tık: Düzenle/Sil">
                                                <Border.ContextMenu>
                                                    <ContextMenu>
                                                        <MenuItem Header="✏️ Grubu Düzenle (Ad / Renk)" Click="GroupMenuEdit_Click" Tag="{Binding}"/>
                                                        <MenuItem Header="Grubu Katla / Aç" Click="GroupMenuToggleCollapse_Click" Tag="{Binding}"/>
                                                        <MenuItem Header="Grubu Sil (Sekmeleri Genel'e Taşı)" Click="GroupMenuDelete_Click" Tag="{Binding}"/>
                                                    </ContextMenu>
                                                </Border.ContextMenu>
                                                <Border.Background>
                                                    <SolidColorBrush Color="{Binding ColorHex}" Opacity="0.28"/>
                                                </Border.Background>
                                                <Border.BorderBrush>
                                                    <SolidColorBrush Color="{Binding ColorHex}"/>
                                                </Border.BorderBrush>
                                                <Border.BorderThickness>1</Border.BorderThickness>
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse Width="7" Height="7" Margin="0,0,5,0">
                                                        <Ellipse.Fill>
                                                            <SolidColorBrush Color="{Binding ColorHex}"/>
                                                        </Ellipse.Fill>
                                                    </Ellipse>
                                                    <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding TabCount, StringFormat=' ({0})'}" FontSize="10.5" Opacity="0.8" VerticalAlignment="Center"/>
                                                    <TextBlock Text=" 💤" FontSize="10" Visibility="{Binding IsCollapsed, Converter={StaticResource BoolToVis}}"/>
                                                </StackPanel>
                                            </Border>

                                            <!-- Bu Gruba Ait Sekmeler -->
                                            <ItemsControl ItemsSource="{Binding Tabs}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border x:Name="TabBorder"
                                                                Visibility="{Binding IsVisibleInTabBar, Converter={StaticResource BoolToVis}}"
                                                                ToolTip="{Binding FullTooltip}"
                                                                Margin="2,0,2,0"
                                                                Padding="8,7"
                                                                Width="{Binding EffectiveTabWidth}"
                                                                MinWidth="44"
                                                                MaxWidth="200"
                                                                CornerRadius="8,8,0,0"
                                                                Cursor="Hand"
                                                                AllowDrop="True"
                                                                RenderTransformOrigin="0.5,0.5"
                                                                BorderThickness="1,1,1,0"
                                                                MouseDown="TabItem_MouseDown"
                                                                PreviewMouseLeftButtonDown="TabItem_PreviewMouseLeftButtonDown"
                                                                MouseMove="TabItem_MouseMove"
                                                                DragEnter="TabItem_DragEnter"
                                                                DragLeave="TabItem_DragLeave"
                                                                DragOver="TabItem_DragOver"
                                                                Drop="TabItem_Drop">
                                                            <Border.RenderTransform>
                                                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                                                            </Border.RenderTransform>
                                                            <Border.Background>
                                                                <SolidColorBrush Color="{Binding GroupColorHex}" Opacity="0.14"/>
                                                            </Border.Background>
                                                            <Border.BorderBrush>
                                                                <SolidColorBrush Color="{Binding GroupColorHex}" Opacity="0.38"/>
                                                            </Border.BorderBrush>
                                                            <Border.ContextMenu>
                                                                <ContextMenu Opened="TabContextMenu_Opened">
                                                                    <MenuItem Header="📌 Sabitle / Sabitlemeyi Kaldır" Click="TabMenuPin_Click" Tag="{Binding}"/>
                                                                    <MenuItem Header="💤 Sekmeyi Uyut (RAM Tasarrufu)" Click="TabMenuSleep_Click" Tag="{Binding}"/>
                                                                    <MenuItem Header="Sesi Aç / Kapat" Click="TabMenuMute_Click" Tag="{Binding}"/>
                                                                    <MenuItem Header="Bölünmüş Ekranda Göster / Kapat" Click="TabMenuSplit_Click" Tag="{Binding}"/>
                                                                    <MenuItem Header="Sekmeyi Çoğalt" Click="TabMenuDuplicate_Click" Tag="{Binding}"/>
                                                                    <MenuItem x:Name="MoveToGroupMenuItem" Header="Gruba Taşı" Tag="{Binding}"/>
                                                                    <Separator/>
                                                                    <MenuItem Header="Sekmeyi Kapat" Click="TabMenuClose_Click" Tag="{Binding}"/>
                                                                </ContextMenu>
                                                            </Border.ContextMenu>
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="4"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>

                                                                <Border Grid.Column="0" Width="4" Height="16" CornerRadius="2" Margin="0,0,6,0">
                                                                    <Border.Background>
                                                                        <SolidColorBrush Color="{Binding GroupColorHex}"/>
                                                                    </Border.Background>
                                                                </Border>

                                                                <Image Grid.Column="1" Source="{Binding FaviconSource}" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>

                                                                <TextBlock x:Name="TabTitleText" Grid.Column="2" Text="{Binding Title}" VerticalAlignment="Center"
                                                                           Opacity="0.72"
                                                                           Visibility="{Binding ShowCloseButton, Converter={StaticResource BoolToVis}}"
                                                                           TextTrimming="CharacterEllipsis" FontSize="12" Margin="0,0,6,0"/>

                                                                <Button Grid.Column="3" Style="{StaticResource EqualizerButtonStyle}" Margin="0,0,2,0"
                                                                        Visibility="{Binding ShowAudioEqualizer, Converter={StaticResource BoolToVis}}"
                                                                        Click="BtnToggleTabMediaPlayback_Click" Tag="{Binding}"/>

                                                                <Button Grid.Column="4" Content="🔇" FontSize="11" Padding="3,0" Background="Transparent" BorderThickness="0" Cursor="Hand"
                                                                        VerticalAlignment="Center" Margin="0,0,2,0" ToolTip="Sesi Aç"
                                                                        Visibility="{Binding IsMuted, Converter={StaticResource BoolToVis}}"
                                                                        Click="BtnToggleTabMute_Click" Tag="{Binding}"/>

                                                                <Button Grid.Column="5" Content="✕" FontSize="10" Padding="4,1"
                                                                        Visibility="{Binding ShowCloseButton, Converter={StaticResource BoolToVis}}"
                                                                        Background="Transparent" Foreground="{DynamicResource TextSecondaryBrush}"
                                                                        BorderThickness="0" Cursor="Hand"
                                                                        Click="BtnCloseSpecificTab_Click" Tag="{Binding}"/>
                                                            </Grid>
                                                        </Border>
                                                        <DataTemplate.Triggers>
                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource HoverBgBrush}"/>
                                                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                                <Setter TargetName="TabBorder" Property="BorderThickness" Value="1.5,3,1.5,0"/>
                                                                <Setter TargetName="TabBorder" Property="Margin" Value="2,0,2,-1"/>
                                                                <Setter TargetName="TabTitleText" Property="FontWeight" Value="Bold"/>
                                                                <Setter TargetName="TabTitleText" Property="Opacity" Value="1"/>
                                                                <Setter TargetName="TabTitleText" Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsDragging}" Value="True">
                                                                <Setter TargetName="TabBorder" Property="Opacity" Value="0.35"/>
                                                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="#F59E0B"/>
                                                                <Setter TargetName="TabBorder" Property="BorderThickness" Value="2,2,2,0"/>
                                                                <Setter TargetName="TabBorder" Property="RenderTransform">
                                                                    <Setter.Value>
                                                                        <ScaleTransform ScaleX="0.94" ScaleY="0.94"/>
                                                                    </Setter.Value>
                                                                </Setter>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsDragTarget}" Value="True">
                                                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                                <Setter TargetName="TabBorder" Property="BorderThickness" Value="4,2,1,0"/>
                                                                <Setter TargetName="TabBorder" Property="RenderTransform">
                                                                    <Setter.Value>
                                                                        <ScaleTransform ScaleX="1.05" ScaleY="1.05"/>
                                                                    </Setter.Value>
                                                                </Setter>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsSleeping}" Value="True">
                                                                <Setter TargetName="TabBorder" Property="Opacity" Value="0.48"/>
                                                            </DataTrigger>
                                                        </DataTemplate.Triggers>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Bağımsız Gizli Sekmeler (Hiçbir Gruba Bağlı Değildir) -->
                        <ItemsControl x:Name="IncognitoTabsItemsControl" VerticalAlignment="Bottom">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="IncTabBorder"
                                            ToolTip="{Binding FullTooltip}"
                                            Margin="2,0,2,0"
                                            Padding="8,7"
                                            Width="{Binding TabWidth}"
                                            MinWidth="68"
                                            MaxWidth="200"
                                            CornerRadius="8,8,0,0"
                                            Cursor="Hand"
                                            AllowDrop="True"
                                            RenderTransformOrigin="0.5,0.5"
                                            Background="#231E2E"
                                            BorderBrush="#7C3AED"
                                            BorderThickness="1,1,1,0"
                                            MouseDown="TabItem_MouseDown"
                                            PreviewMouseLeftButtonDown="TabItem_PreviewMouseLeftButtonDown"
                                            MouseMove="TabItem_MouseMove"
                                            DragEnter="TabItem_DragEnter"
                                            DragLeave="TabItem_DragLeave"
                                            DragOver="TabItem_DragOver"
                                            Drop="TabItem_Drop">
                                        <Border.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="Sesi Aç / Kapat" Click="TabMenuMute_Click" Tag="{Binding}"/>
                                                <MenuItem Header="Bölünmüş Ekranda Göster / Kapat" Click="TabMenuSplit_Click" Tag="{Binding}"/>
                                                <MenuItem Header="Sekmeyi Çoğalt" Click="TabMenuDuplicate_Click" Tag="{Binding}"/>
                                                <Separator/>
                                                <MenuItem Header="Gizli Sekmeyi Kapat" Click="TabMenuClose_Click" Tag="{Binding}"/>
                                            </ContextMenu>
                                        </Border.ContextMenu>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="🕶️" FontSize="11" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                            <Image Grid.Column="1" Source="{Binding FaviconSource}" Width="14" Height="14" Margin="0,0,5,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                                            <TextBlock x:Name="IncTabTitleText" Grid.Column="2" Text="{Binding Title}" Foreground="#C4B5FD" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" FontSize="12" Margin="0,0,6,0"/>
                                            <Button Grid.Column="3" Style="{StaticResource EqualizerButtonStyle}" Margin="0,0,2,0"
                                                    Visibility="{Binding ShowAudioEqualizer, Converter={StaticResource BoolToVis}}"
                                                    Click="BtnToggleTabMediaPlayback_Click" Tag="{Binding}"/>
                                            <Button Grid.Column="4" Content="🔇" FontSize="11" Padding="3,0" Background="Transparent" BorderThickness="0" Cursor="Hand"
                                                    VerticalAlignment="Center" Margin="0,0,2,0" ToolTip="Sesi Aç"
                                                    Visibility="{Binding IsMuted, Converter={StaticResource BoolToVis}}"
                                                    Click="BtnToggleTabMute_Click" Tag="{Binding}"/>
                                            <Button Grid.Column="5" Content="✕" FontSize="10" Padding="4,1" Background="Transparent" Foreground="#C4B5FD" BorderThickness="0" Cursor="Hand" Click="BtnCloseSpecificTab_Click" Tag="{Binding}"/>
                                        </Grid>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                            <Setter TargetName="IncTabBorder" Property="Background" Value="#43306B"/>
                                            <Setter TargetName="IncTabBorder" Property="BorderBrush" Value="#C084FC"/>
                                            <Setter TargetName="IncTabBorder" Property="BorderThickness" Value="1.5,3,1.5,0"/>
                                            <Setter TargetName="IncTabBorder" Property="Margin" Value="2,0,2,-1"/>
                                            <Setter TargetName="IncTabTitleText" Property="FontWeight" Value="Bold"/>
                                            <Setter TargetName="IncTabTitleText" Property="Foreground" Value="White"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsDragging}" Value="True">
                                            <Setter TargetName="IncTabBorder" Property="Opacity" Value="0.35"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsDragTarget}" Value="True">
                                            <Setter TargetName="IncTabBorder" Property="BorderBrush" Value="#C084FC"/>
                                            <Setter TargetName="IncTabBorder" Property="BorderThickness" Value="4,2,1,0"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Yeni Sekme (+) ve Geri Aç Butonları Son Sekmenin Hemen Sağında -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0,4,4">
                            <Button x:Name="BtnNewTab" Style="{StaticResource PillActionButton}" Content="+" FontWeight="Bold" FontSize="15" ToolTip="Yeni Sekme (Ctrl+T)" Click="BtnNewTab_Click"/>
                            <Button x:Name="BtnRestoreTab" Style="{StaticResource PillActionButton}" Content="↺" ToolTip="Son Kapatılan Sekmeyi Aç (Ctrl+Shift+T)" Visibility="Collapsed" Click="BtnRestoreTab_Click"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- 2. KATMAN: NAVİGASYON ÇUBUĞU -->
        <Border Grid.Row="1" Background="{DynamicResource BarBgBrush}" BorderBrush="{DynamicResource BorderBrushSubtle}" BorderThickness="0,0,0,1" Padding="8,5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Sol Gezinme Butonları (Gradyan) -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                    <Button x:Name="BtnBack" Style="{StaticResource GradientIconButton}" ToolTip="Geri (Alt+Sol)" Click="BtnBack_Click">
                        <Button.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#0284C7" Offset="0"/>
                                <GradientStop Color="#00B37E" Offset="1"/>
                            </LinearGradientBrush>
                        </Button.Background>
                        <Path Data="M10,2 L4,8 L10,14" Stroke="White" StrokeThickness="2" Width="13" Height="13" Stretch="Uniform"/>
                    </Button>
                    <Button x:Name="BtnForward" Style="{StaticResource GradientIconButton}" ToolTip="İleri (Alt+Sağ)" Click="BtnForward_Click">
                        <Button.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#0284C7" Offset="0"/>
                                <GradientStop Color="#00B37E" Offset="1"/>
                            </LinearGradientBrush>
                        </Button.Background>
                        <Path Data="M6,2 L12,8 L6,14" Stroke="White" StrokeThickness="2" Width="13" Height="13" Stretch="Uniform"/>
                    </Button>
                    <Button x:Name="BtnReload" Style="{StaticResource GradientIconButton}" ToolTip="Yenile (Ctrl+R)" Click="BtnReload_Click">
                        <Button.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#0EA5E9" Offset="0"/>
                                <GradientStop Color="#2563EB" Offset="1"/>
                            </LinearGradientBrush>
                        </Button.Background>
                        <Path Data="M13,8 A5,5 0 1 1 11.5,4.5 M13,2 V5.5 H9.5" Stroke="White" StrokeThickness="1.8" Width="14" Height="14" Stretch="Uniform"/>
                    </Button>
                    <Button x:Name="BtnHome" Style="{StaticResource GradientIconButton}" ToolTip="Ana Sayfa" Click="BtnHome_Click">
                        <Button.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#10B981" Offset="0"/>
                                <GradientStop Color="#059669" Offset="1"/>
                            </LinearGradientBrush>
                        </Button.Background>
                        <Path Data="M2,8 L8,2 L14,8 M4,7 V14 H12 V7" Stroke="White" StrokeThickness="1.7" Width="14" Height="14" Stretch="Uniform"/>
                    </Button>
                </StackPanel>

                <!-- Orta Adres Çubuğu + Öneriler -->
                <Grid Grid.Column="1" Margin="0,0,8,0">
                    <Border x:Name="UrlBarBorder" Background="{DynamicResource AppBgBrush}" BorderBrush="{DynamicResource BorderBrushSubtle}" BorderThickness="1" CornerRadius="8">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" x:Name="BtnGo" Style="{StaticResource GradientIconButton}" Content="Git" Padding="14,5" Margin="3" FontWeight="Bold" FontSize="12" Click="BtnGo_Click">
                                <Button.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#00B37E" Offset="0"/>
                                        <GradientStop Color="#0284C7" Offset="1"/>
                                    </LinearGradientBrush>
                                </Button.Background>
                            </Button>
                            <Border DockPanel.Dock="Left" x:Name="IncognitoBadge" Background="#7C3AED" CornerRadius="6" Padding="8,2" Margin="4,3,0,3" Visibility="Collapsed">
                                <TextBlock Text="🕶️ Gizli" Foreground="White" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock DockPanel.Dock="Right" x:Name="LoadingBadge" Text="⏳" VerticalAlignment="Center" Margin="4,0" Visibility="Collapsed"/>
                            <TextBox x:Name="UrlTextBox"
                                     Tag="Adres yazın veya Google'da arayın..."
                                     Background="Transparent"
                                     Foreground="{DynamicResource TextPrimaryBrush}"
                                     CaretBrush="{DynamicResource TextPrimaryBrush}"
                                     BorderThickness="0"
                                     VerticalContentAlignment="Center"
                                     Padding="10,0"
                                     FontSize="13"
                                     TextChanged="UrlTextBox_TextChanged"
                                     PreviewKeyDown="UrlTextBox_PreviewKeyDown"
                                     GotFocus="UrlTextBox_GotFocus"
                                     LostFocus="UrlTextBox_LostFocus"/>
                        </DockPanel>
                    </Border>

                    <Popup x:Name="SuggestionsPopup"
                           PlacementTarget="{Binding ElementName=UrlBarBorder}"
                           Placement="Bottom"
                           StaysOpen="False"
                           AllowsTransparency="True"
                           Width="{Binding ActualWidth, ElementName=UrlBarBorder}">
                        <Border Background="{DynamicResource BarBgBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" CornerRadius="8" Margin="0,4,0,0" Padding="4">
                            <ListBox x:Name="SuggestionsListBox"
                                     ItemContainerStyle="{StaticResource SuggestionListBoxItemStyle}"
                                     Background="Transparent"
                                     Foreground="{DynamicResource TextPrimaryBrush}"
                                     BorderThickness="0"
                                     MaxHeight="220"
                                     MouseLeftButtonUp="SuggestionsListBox_MouseLeftButtonUp"
                                     KeyDown="SuggestionsListBox_KeyDown"/>
                        </Border>
                    </Popup>
                </Grid>

                <!-- Sağ Araçlar -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- İndirme Kapsülü -->
                    <Border x:Name="DownloadPill" Background="{DynamicResource SurfaceBgBrush}" CornerRadius="6" Padding="8,3" Margin="0,0,6,0" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="📥" Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <StackPanel Width="95" VerticalAlignment="Center">
                                <TextBlock x:Name="DownloadFileNameText" Text="dosya" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                <ProgressBar x:Name="DownloadProgressBar" Height="4" Minimum="0" Maximum="100" Foreground="{DynamicResource AccentBrush}"/>
                            </StackPanel>
                            <TextBlock x:Name="DownloadPercentText" Text="%0" FontSize="11" Margin="5,0,4,0" VerticalAlignment="Center"/>
                            <Button x:Name="BtnOpenDownloadFolder" Style="{StaticResource IconToolButton}" Content="📁" Padding="4,1" Click="BtnOpenDownloadFolder_Click" Visibility="Collapsed"/>
                            <Button Style="{StaticResource IconToolButton}" Content="✕" Padding="4,1" Click="BtnCloseDownloadPill_Click"/>
                        </StackPanel>
                    </Border>

                    <!-- Görünüm & Medya Grubu (Gradyan) -->
                    <Button x:Name="BtnSplitScreen" Style="{StaticResource GradientIconButton}" Padding="10,6" ToolTip="Bölünmüş Ekran (Yan Yana 2 Sekme)" Click="BtnSplitScreen_Click">
                        <Button.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#0EA5E9" Offset="0"/>
                                <GradientStop Color="#2563EB" Offset="1"/>
                            </LinearGradientBrush>
                        </Button.Background>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="M2,2 H14 V14 H2 Z M8,2 V14" Stroke="White" StrokeThickness="1.5" Width="13" Height="13" Stretch="Uniform" Margin="0,0,5,0"/>
                            <TextBlock Text="Böl" FontSize="12" FontWeight="SemiBold" Foreground="White"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnSnip" Style="{StaticResource GradientIconButton}" ToolTip="Bölgesel Ekran Kırpma" Click="BtnSnip_Click">
                        <Button.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#F59E0B" Offset="0"/>
                                <GradientStop Color="#EA580C" Offset="1"/>
                            </LinearGradientBrush>
                        </Button.Background>
                        <Path Data="M4,4 L12,12 M12,4 L4,12 M3,13 A2,2 0 1 1 3,9 M13,13 A2,2 0 1 1 13,9" Stroke="White" StrokeThickness="1.6" Width="14" Height="14" Stretch="Uniform"/>
                    </Button>
                    <Button x:Name="BtnMiniPip" Style="{StaticResource GradientIconButton}" Padding="10,6" ToolTip="Videoyu Resim İçinde Resim (Her Zaman Üstte) Olarak Aç" Click="BtnMiniPip_Click">
                        <Button.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#10B981" Offset="0"/>
                                <GradientStop Color="#059669" Offset="1"/>
                            </LinearGradientBrush>
                        </Button.Background>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="M1,2 H15 V12 H1 Z M8,7 H14 V11 H8 Z" Stroke="White" StrokeThickness="1.5" Width="14" Height="12" Stretch="Uniform" Margin="0,0,5,0"/>
                            <TextBlock Text="Mini Video" FontSize="12" FontWeight="SemiBold" Foreground="White"/>
                        </StackPanel>
                    </Button>

                    <Border Width="1" Height="18" Background="{DynamicResource BorderBrushSubtle}" Margin="4,0"/>

                    <!-- Yapay Zeka Grubu (Gradyan) -->
                    <Button x:Name="BtnSummarizePage" Style="{StaticResource GradientIconButton}" Padding="10,6" ToolTip="Aktif Sayfayı Gemini ile Özetle" Click="BtnSummarizePage_Click">
                        <Button.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#6366F1" Offset="0"/>
                                <GradientStop Color="#8B5CF6" Offset="1"/>
                            </LinearGradientBrush>
                        </Button.Background>
                        <TextBlock Text="✨ Özetle" FontSize="12" FontWeight="SemiBold" Foreground="White"/>
                    </Button>

                    <Button x:Name="BtnGeminiToggle" Style="{StaticResource GradientIconButton}" Padding="10,6" ToolTip="Gemini Asistan Paneli" Click="BtnGeminiToggle_Click">
                        <Button.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#0284C7" Offset="0"/>
                                <GradientStop Color="#00B37E" Offset="1"/>
                            </LinearGradientBrush>
                        </Button.Background>
                        <TextBlock Text="✨ Gemini" FontSize="12" FontWeight="SemiBold" Foreground="White"/>
                    </Button>

                    <Border Width="1" Height="18" Background="{DynamicResource BorderBrushSubtle}" Margin="4,0"/>

                    <!-- Panel & Araçlar Grubu (Gradyan) -->
                    <Button x:Name="BtnDownloads" Style="{StaticResource GradientIconButton}" ToolTip="İndirilenler Paneli (Ctrl+J)" Click="BtnDownloads_Click">
                        <Button.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#0891B2" Offset="0"/>
                                <GradientStop Color="#0284C7" Offset="1"/>
                            </LinearGradientBrush>
                        </Button.Background>
                        <Path Data="M8,1 V10 M4,7 L8,11 L12,7 M2,14 H14" Stroke="White" StrokeThickness="1.7" Width="13" Height="13" Stretch="Uniform"/>
                    </Button>
                    <Button x:Name="BtnHistory" Style="{StaticResource GradientIconButton}" ToolTip="Tarama Geçmişi (Ctrl+H)" Click="BtnHistory_Click">
                        <Button.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#8B5CF6" Offset="0"/>
                                <GradientStop Color="#EC4899" Offset="1"/>
                            </LinearGradientBrush>
                        </Button.Background>
                        <Path Data="M8,3 V8 L11,10 M2,8 A6,6 0 1 1 8,14 A6,6 0 0 1 3,11" Stroke="White" StrokeThickness="1.6" Width="13" Height="13" Stretch="Uniform"/>
                    </Button>
                    <Button x:Name="BtnCommandPalette" Style="{StaticResource GradientIconButton}" Padding="9,5" ToolTip="Hızlı Komut Paleti (Ctrl+K)" Click="BtnCommandPalette_Click">
                        <Button.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#6366F1" Offset="0"/>
                                <GradientStop Color="#3B82F6" Offset="1"/>
                            </LinearGradientBrush>
                        </Button.Background>
                        <TextBlock Text="⌘" FontSize="13" FontWeight="Bold" Foreground="White"/>
                    </Button>
                    <Button x:Name="BtnQrCode" Style="{StaticResource GradientIconButton}" ToolTip="Bu Sayfa İçin QR Kod Oluştur" Click="BtnQrCode_Click">
                        <Button.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#14B8A6" Offset="0"/>
                                <GradientStop Color="#0D9488" Offset="1"/>
                            </LinearGradientBrush>
                        </Button.Background>
                        <Path Data="M2,2 H6 V6 H2 Z M10,2 H14 V6 H10 Z M2,10 H6 V14 H2 Z M10,10 H12 V12 H10 Z M13,12 H14 V14 H12" Stroke="White" StrokeThickness="1.5" Width="13" Height="13" Stretch="Uniform"/>
                    </Button>
                    <Button x:Name="BtnFind" Style="{StaticResource GradientIconButton}" ToolTip="Sayfada Bul (Ctrl+F)" Click="BtnFind_Click">
                        <Button.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#F97316" Offset="0"/>
                                <GradientStop Color="#EF4444" Offset="1"/>
                            </LinearGradientBrush>
                        </Button.Background>
                        <Path Data="M6.5,1 A5.5,5.5 0 1 1 6.49,1 Z M10.5,10.5 L14.5,14.5" Stroke="White" StrokeThickness="1.7" Width="13" Height="13" Stretch="Uniform"/>
                    </Button>
                    <Button x:Name="BtnSettings" Style="{StaticResource GradientIconButton}" ToolTip="Ayarlar, Şifre Kasası ve Gizlilik" Click="BtnSettings_Click">
                        <Button.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#475569" Offset="0"/>
                                <GradientStop Color="#1E293B" Offset="1"/>
                            </LinearGradientBrush>
                        </Button.Background>
                        <Path Data="M8,5 A3,3 0 1 1 7.99,5 Z M8,1 V3 M8,13 V15 M1,8 H3 M13,8 H15 M3,3 L4.5,4.5 M11.5,11.5 L13,13 M13,3 L11.5,4.5 M4.5,11.5 L3,13" Stroke="White" StrokeThickness="1.6" Width="14" Height="14" Stretch="Uniform"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- SAYFA İÇİ ARAMA ÇUBUĞU (Ctrl+F) VE ŞİFRE KAYDETME ÇUBUĞU -->
        <StackPanel Grid.Row="2">
            <Border x:Name="PasswordSaveBar" Background="{DynamicResource SurfaceBgBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="0,0,0,1" Padding="12,7" Visibility="Collapsed">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button x:Name="BtnSaveCapturedPwd" Content="✓ Kaydet / Güncelle" Padding="12,5" Margin="0,0,6,0" Background="{DynamicResource AccentBrush}" Foreground="White" BorderThickness="0" FontWeight="SemiBold" Cursor="Hand" Click="BtnSaveCapturedPwd_Click"/>
                        <Button Content="Şimdi Değil" Padding="10,5" Background="Transparent" Foreground="{DynamicResource TextSecondaryBrush}" BorderBrush="{DynamicResource BorderBrushSubtle}" BorderThickness="1" Cursor="Hand" Click="BtnDismissCapturedPwd_Click"/>
                    </StackPanel>
                    <TextBlock x:Name="PasswordSavePromptText" Text="🔐 Şifre kaydedilsin mi?" VerticalAlignment="Center" FontSize="12.5" FontWeight="SemiBold"/>
                </DockPanel>
            </Border>

            <Border x:Name="FindBar" Background="{DynamicResource SurfaceBgBrush}" BorderBrush="{DynamicResource BorderBrushSubtle}" BorderThickness="0,0,0,1" Padding="10,6" Visibility="Collapsed">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock Text="Sayfada Bul:" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"/>
                <TextBox x:Name="FindTextBox" Width="220" Padding="6,3" Background="{DynamicResource AppBgBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderBrushSubtle}" KeyDown="FindTextBox_KeyDown"/>
                <Button Style="{StaticResource IconToolButton}" Content="▲" ToolTip="Önceki" Click="BtnFindPrev_Click"/>
                <Button Style="{StaticResource IconToolButton}" Content="▼" ToolTip="Sonraki" Click="BtnFindNext_Click"/>
                <Button Style="{StaticResource IconToolButton}" Content="✕" ToolTip="Kapat (Esc)" Click="BtnFindClose_Click"/>
            </StackPanel>
            </Border>
        </StackPanel>

        <!-- 3. KATMAN: SOL YAN BAR + ANA İÇERİK + GEMİNİ + AYAR + GEÇMİŞ/İNDİRMELER -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- SOL KAYAR / SABİTLENEBİLİR YAN UYGULAMA BARI -->
            <Grid Grid.Column="0" Background="{DynamicResource AppBgBrush}" MouseLeave="SidebarArea_MouseLeave">
                <!-- Bar gizliyken sol kenarda ince sensör -->
                <Border x:Name="SidebarHoverTrigger" Width="6" Background="Transparent" MouseEnter="SidebarHoverTrigger_MouseEnter" Visibility="Collapsed"/>

                <Border x:Name="SidebarRail" Width="50" Background="{DynamicResource BarBgBrush}" BorderBrush="{DynamicResource BorderBrushSubtle}" BorderThickness="0,0,1,0" Padding="4,8">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                            <Button x:Name="BtnPinSidebar" Style="{StaticResource IconToolButton}" Content="📌" ToolTip="Yan Barı Sabitle / Gizle (Kenara gelince açılır)" Click="BtnPinSidebar_Click"/>
                            <Separator Background="{DynamicResource BorderBrushSubtle}" Margin="4,6"/>
                        </StackPanel>

                        <Button DockPanel.Dock="Bottom" Style="{StaticResource IconToolButton}" Content="➕" FontSize="15" ToolTip="Yan Bara Uygulama / Site Ekle" Click="BtnOpenAddSidebarApp_Click"/>

                        <ScrollViewer VerticalScrollBarVisibility="Hidden">
                            <ItemsControl x:Name="SidebarAppsItemsControl">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource IconToolButton}" Padding="4,8" Margin="0,2"
                                                ToolTip="{Binding Name}" Click="BtnSidebarApp_Click" Tag="{Binding}">
                                            <Button.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="Yeni Sekmede Aç" Click="SidebarMenuOpenTab_Click" Tag="{Binding}"/>
                                                    <MenuItem Header="Yan Bardan Kaldır" Click="SidebarMenuRemove_Click" Tag="{Binding}"/>
                                                </ContextMenu>
                                            </Button.ContextMenu>
                                            <Grid Width="24" Height="24">
                                                <TextBlock Text="{Binding Icon}" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasFavicon}" Value="True">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <Image Source="{Binding FaviconSource}" Width="20" Height="20" RenderOptions.BitmapScalingMode="HighQuality"
                                                       Visibility="{Binding HasFavicon, Converter={StaticResource BoolToVis}}"/>
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- SOL YAN UYGULAMA PANELİ (WhatsApp, Telegram vb.) -->
            <Border x:Name="SidebarWebDrawer" Grid.Column="1" Width="430" Background="{DynamicResource BarBgBrush}" BorderBrush="{DynamicResource BorderBrushSubtle}" BorderThickness="0,0,1,0" Visibility="Collapsed">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Padding="10,8" BorderBrush="{DynamicResource BorderBrushSubtle}" BorderThickness="0,0,0,1">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource IconToolButton}" Content="✕" Click="BtnCloseSidebarDrawer_Click"/>
                            <Button DockPanel.Dock="Right" Style="{StaticResource IconToolButton}" Content="⟳" ToolTip="Yenile" Click="BtnReloadSidebarDrawer_Click"/>
                            <TextBlock x:Name="SidebarDrawerTitleText" Text="Yan Uygulama" FontWeight="Bold" FontSize="13.5" VerticalAlignment="Center"/>
                        </DockPanel>
                    </Border>
                    <wv2:WebView2 x:Name="SidebarWebView"/>
                </DockPanel>
            </Border>

            <!-- TARAYICI İÇERİK ALANI -->
            <Grid Grid.Column="2">
                <!-- WebView2 Sekmeleri ve Split View (WebView2'ler doğrudan bu Grid'de kalır) -->
                <Grid x:Name="WebAreaGrid">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="0" x:Name="SplitColumn"/>
                    </Grid.ColumnDefinitions>

                    <GridSplitter x:Name="SplitDivider" Grid.Column="1" Width="7" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                                  ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" Cursor="SizeWE"
                                  Background="{DynamicResource BarBgBrush}" Visibility="Collapsed">
                        <GridSplitter.Template>
                            <ControlTemplate TargetType="GridSplitter">
                                <Border Background="{DynamicResource BarBgBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1,0">
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <Ellipse Width="3" Height="3" Fill="{DynamicResource AccentBrush}" Margin="0,2"/>
                                        <Ellipse Width="3" Height="3" Fill="{DynamicResource AccentBrush}" Margin="0,2"/>
                                        <Ellipse Width="3" Height="3" Fill="{DynamicResource AccentBrush}" Margin="0,2"/>
                                    </StackPanel>
                                </Border>
                            </ControlTemplate>
                        </GridSplitter.Template>
                    </GridSplitter>
                </Grid>

                <!-- NATIVE ANA SAYFA DASHBOARD -->
                <ScrollViewer x:Name="HomePageOverlay" Background="{DynamicResource AppBgBrush}" VerticalScrollBarVisibility="Auto" Visibility="Visible">
                    <StackPanel MaxWidth="1160" Margin="24,18,24,32">

                        <!-- ÜST HERO KARTI: HAVA DURUMU + LED DİJİTAL SAAT + EZAN VAKİTLERİ -->
                        <Border Style="{StaticResource DashboardCard}" Margin="0,0,0,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.1*"/>
                                    <ColumnDefinition Width="1.3*"/>
                                    <ColumnDefinition Width="1.5*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Sol: Konum ve Hava Durumu -->
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                    <Button x:Name="BtnChangeLocation" Style="{StaticResource PillActionButton}" HorizontalAlignment="Left" Click="BtnChangeLocation_Click" Margin="0,0,0,10">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock x:Name="WeatherLocationText" Text="📍 İstanbul, Kadıköy" FontWeight="SemiBold"/>
                                            <TextBlock Text=" ✏️" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        </StackPanel>
                                    </Button>
                                    <Border Background="{DynamicResource SurfaceBgBrush}" CornerRadius="10" Padding="12,10" HorizontalAlignment="Left">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock x:Name="WeatherIconText" Text="⛅" FontSize="38" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock x:Name="WeatherTempText" Text="--°C" FontSize="26" FontWeight="Bold"/>
                                                <TextBlock x:Name="WeatherDescText" Text="Yükleniyor..." FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <!-- Orta: LED 7-Segment Tarzı Dijital Saat & Tarih -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <Border Background="{DynamicResource ClockDisplayBgBrush}" BorderBrush="{DynamicResource BorderBrushSubtle}" BorderThickness="1" CornerRadius="12" Padding="22,10">
                                        <TextBlock x:Name="ClockTimeText" Text="00:00:00" FontSize="42" FontWeight="Bold" FontFamily="Consolas" Foreground="{DynamicResource ClockLedBrush}" HorizontalAlignment="Center">
                                            <TextBlock.Effect>
                                                <DropShadowEffect Color="{DynamicResource ClockLedColor}" BlurRadius="14" ShadowDepth="0" Opacity="0.65"/>
                                            </TextBlock.Effect>
                                        </TextBlock>
                                    </Border>
                                    <TextBlock x:Name="ClockDateText" Text="-- -- ----" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                                </StackPanel>

                                <!-- Sağ: Ezan Vakitleri & Aktif Vakit Vurgusu -->
                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="14,0,0,0">
                                    <DockPanel Margin="0,0,0,8">
                                        <Border DockPanel.Dock="Right" Background="{DynamicResource AccentBrush}" CornerRadius="10" Padding="10,3">
                                            <TextBlock x:Name="NextPrayerCountdownText" Text="--:-- kaldı" FontSize="11" FontWeight="Bold" Foreground="White"/>
                                        </Border>
                                        <TextBlock Text="🕌 Ezan Vakitleri" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                                    </DockPanel>
                                    <UniformGrid Columns="3">
                                        <Border x:Name="ChipImsak" Style="{StaticResource PrayerChip}">
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock Text="İmsak" FontSize="10" Opacity="0.8" HorizontalAlignment="Center"/>
                                                <TextBlock x:Name="PrayerImsakText" Text="--:--" FontSize="13" FontWeight="Bold" FontFamily="Consolas" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                        <Border x:Name="ChipGunes" Style="{StaticResource PrayerChip}">
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock Text="Güneş" FontSize="10" Opacity="0.8" HorizontalAlignment="Center"/>
                                                <TextBlock x:Name="PrayerGunesText" Text="--:--" FontSize="13" FontWeight="Bold" FontFamily="Consolas" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                        <Border x:Name="ChipOgle" Style="{StaticResource PrayerChip}">
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock Text="Öğle" FontSize="10" Opacity="0.8" HorizontalAlignment="Center"/>
                                                <TextBlock x:Name="PrayerOgleText" Text="--:--" FontSize="13" FontWeight="Bold" FontFamily="Consolas" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                        <Border x:Name="ChipIkindi" Style="{StaticResource PrayerChip}">
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock Text="İkindi" FontSize="10" Opacity="0.8" HorizontalAlignment="Center"/>
                                                <TextBlock x:Name="PrayerIkindiText" Text="--:--" FontSize="13" FontWeight="Bold" FontFamily="Consolas" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                        <Border x:Name="ChipAksam" Style="{StaticResource PrayerChip}">
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock Text="Akşam" FontSize="10" Opacity="0.8" HorizontalAlignment="Center"/>
                                                <TextBlock x:Name="PrayerAksamText" Text="--:--" FontSize="13" FontWeight="Bold" FontFamily="Consolas" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                        <Border x:Name="ChipYatsi" Style="{StaticResource PrayerChip}">
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock Text="Yatsı" FontSize="10" Opacity="0.8" HorizontalAlignment="Center"/>
                                                <TextBlock x:Name="PrayerYatsiText" Text="--:--" FontSize="13" FontWeight="Bold" FontFamily="Consolas" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                    </UniformGrid>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- ARAMA ÇUBUĞU -->
                        <Grid Margin="0,0,0,16">
                            <Border x:Name="HomeSearchBorder" Background="{DynamicResource BarBgBrush}" BorderBrush="{DynamicResource BorderBrushSubtle}" BorderThickness="1" CornerRadius="12" Padding="6">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="Google'da Ara / Git" Padding="18,8" Background="{DynamicResource AccentBrush}" Foreground="White" BorderThickness="0" FontWeight="SemiBold" Cursor="Hand" Click="BtnHomeSearch_Click"/>
                                    <TextBox x:Name="HomeSearchBox" Tag="Web'de arayın veya bir adres yazın..." Background="Transparent" Foreground="{DynamicResource TextPrimaryBrush}" CaretBrush="{DynamicResource TextPrimaryBrush}" BorderThickness="0" FontSize="14" Padding="10,6" VerticalContentAlignment="Center" TextChanged="HomeSearchBox_TextChanged" PreviewKeyDown="HomeSearchBox_PreviewKeyDown" LostFocus="HomeSearchBox_LostFocus"/>
                                </DockPanel>
                            </Border>
                            <Popup x:Name="HomeSuggestionsPopup"
                                   PlacementTarget="{Binding ElementName=HomeSearchBorder}"
                                   Placement="Bottom"
                                   StaysOpen="False"
                                   AllowsTransparency="True"
                                   Width="{Binding ActualWidth, ElementName=HomeSearchBorder}">
                                <Border Background="{DynamicResource BarBgBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" CornerRadius="8" Margin="0,4,0,0" Padding="4">
                                    <ListBox x:Name="HomeSuggestionsListBox"
                                             ItemContainerStyle="{StaticResource SuggestionListBoxItemStyle}"
                                             Background="Transparent"
                                             Foreground="{DynamicResource TextPrimaryBrush}"
                                             BorderThickness="0"
                                             MaxHeight="220"
                                             MouseLeftButtonUp="HomeSuggestionsListBox_MouseLeftButtonUp"
                                             KeyDown="HomeSuggestionsListBox_KeyDown"/>
                                </Border>
                            </Popup>
                        </Grid>

                        <!-- ORTA SATIR: HIZLI YER İMLERİ + ZAMANLI HATIRLATICILAR -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Hızlı Yer İmleri -->
                            <Border Grid.Column="0" Style="{StaticResource DashboardCard}">
                                <StackPanel>
                                    <TextBlock Text="🔖 Hızlı Yer İmleri" FontSize="15" FontWeight="Bold" Margin="0,0,0,10"/>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="1.4*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="BmTitleBox" Grid.Column="0" Margin="0,0,6,0" Padding="6,5" Background="{DynamicResource AppBgBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderBrushSubtle}" Tag="Başlık (örn: GitHub)" KeyDown="BmBox_KeyDown"/>
                                        <TextBox x:Name="BmUrlBox" Grid.Column="1" Margin="0,0,6,0" Padding="6,5" Background="{DynamicResource AppBgBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderBrushSubtle}" Tag="Örnek URL (https://...)" KeyDown="BmBox_KeyDown"/>
                                        <Button Grid.Column="2" Content="Ekle" Padding="12,5" Background="{DynamicResource AccentBrush}" Foreground="White" BorderThickness="0" Cursor="Hand" Click="BtnAddBookmark_Click"/>
                                    </Grid>
                                    <ItemsControl x:Name="BookmarksItemsControl">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{DynamicResource SurfaceBgBrush}" BorderBrush="{DynamicResource BorderBrushSubtle}" BorderThickness="1" CornerRadius="8" Padding="10,6" Margin="0,0,8,8" Cursor="Hand">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0" MouseLeftButtonDown="BookmarkItem_Click" Tag="{Binding}"/>
                                                        <Button Content="✕" FontSize="10" Padding="3,0" Background="Transparent" Foreground="{DynamicResource TextSecondaryBrush}" BorderThickness="0" Click="BtnDeleteBookmark_Click" Tag="{Binding}"/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <!-- Zamanlı Hatırlatıcılar -->
                            <Border Grid.Column="2" Style="{StaticResource DashboardCard}">
                                <StackPanel>
                                    <TextBlock Text="⏰ Zamanlı Hatırlatıcılar" FontSize="15" FontWeight="Bold" Margin="0,0,0,10"/>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.4*"/>
                                            <ColumnDefinition Width="125"/>
                                            <ColumnDefinition Width="75"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="RemTextBox" Grid.Column="0" Margin="0,0,6,0" Padding="6,5" Background="{DynamicResource AppBgBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderBrushSubtle}" Tag="Görev veya hatırlatma..."/>
                                        <DatePicker x:Name="RemDatePicker" Grid.Column="1" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBox x:Name="RemTimeBox" Grid.Column="2" Margin="0,0,6,0" Padding="6,5" MaxLength="5" Background="{DynamicResource AppBgBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderBrushSubtle}" Tag="09:30" TextChanged="RemTimeBox_TextChanged" KeyDown="RemBox_KeyDown"/>
                                        <Button Grid.Column="3" Content="Ekle" Padding="12,5" Background="{DynamicResource AccentBrush}" Foreground="White" BorderThickness="0" Cursor="Hand" Click="BtnAddReminder_Click"/>
                                    </Grid>
                                    <ItemsControl x:Name="RemindersItemsControl">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border x:Name="RemBorder" Background="{DynamicResource SurfaceBgBrush}" CornerRadius="6" Padding="8,6" Margin="0,0,0,6">
                                                    <DockPanel>
                                                        <Button DockPanel.Dock="Right" Content="✕" FontSize="10" Padding="4,0" Background="Transparent" Foreground="{DynamicResource TextSecondaryBrush}" BorderThickness="0" Click="BtnDeleteReminder_Click" Tag="{Binding}"/>
                                                        <TextBlock DockPanel.Dock="Right" Text="{Binding DueTime, StringFormat='{}{0:dd.MM HH:mm}'}" FontSize="11" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                        <TextBlock x:Name="RemText" Text="{Binding Text}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                    </DockPanel>
                                                </Border>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                        <Setter TargetName="RemBorder" Property="Opacity" Value="0.42"/>
                                                        <Setter TargetName="RemText" Property="TextDecorations" Value="Strikethrough"/>
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- ALT SATIR: RENKLİ VE SÜRÜKLENEBİLİR YAPIŞKAN NOTLAR -->
                        <Border Style="{StaticResource DashboardCard}">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,12">
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                        <TextBox x:Name="NoteInputBox" Width="320" Padding="8,5" Margin="0,0,8,0" Background="{DynamicResource AppBgBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderBrushSubtle}" Tag="Yeni bir not yazın ve Enter'a basın..." KeyDown="NoteInputBox_KeyDown"/>
                                        <Button Content="➕ Not Ekle" Padding="12,5" Background="{DynamicResource AccentBrush}" Foreground="White" BorderThickness="0" FontWeight="SemiBold" Cursor="Hand" Click="BtnAddNote_Click"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="📌 Yapışkan Notlar" FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/>
                                        <TextBlock Text="  (Sürükleyerek taşıyın, noktalardan renk seçin)" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DockPanel>

                                <ItemsControl x:Name="StickyNotesItemsControl">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,6,14,14" VerticalAlignment="Top">
                                                <Border x:Name="NoteCard"
                                                        Width="248" MinHeight="125" MaxHeight="225" VerticalAlignment="Top"
                                                        CornerRadius="4,4,16,4" Padding="14,16,14,14"
                                                        Cursor="SizeAll" AllowDrop="True"
                                                        RenderTransformOrigin="0.5,0.5"
                                                        PreviewMouseLeftButtonDown="StickyNote_PreviewMouseLeftButtonDown"
                                                        MouseMove="StickyNote_MouseMove"
                                                        DragEnter="StickyNote_DragEnter"
                                                        DragLeave="StickyNote_DragLeave"
                                                        DragOver="StickyNote_DragOver"
                                                        Drop="StickyNote_Drop">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="BorderBrush" Value="#22000000"/>
                                                            <Setter Property="BorderThickness" Value="1,1,2,3"/>
                                                            <Setter Property="Opacity" Value="1"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsDragging}" Value="True">
                                                                    <Setter Property="Opacity" Value="0.35"/>
                                                                    <Setter Property="BorderBrush" Value="#F59E0B"/>
                                                                    <Setter Property="BorderThickness" Value="2"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsDragTarget}" Value="True">
                                                                    <Setter Property="BorderBrush" Value="#00B37E"/>
                                                                    <Setter Property="BorderThickness" Value="3"/>
                                                                    <Setter Property="Opacity" Value="0.95"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <Border.Background>
                                                        <SolidColorBrush Color="{Binding ColorHex}"/>
                                                    </Border.Background>
                                                    <Border.RenderTransform>
                                                        <TransformGroup>
                                                            <ScaleTransform ScaleX="1" ScaleY="1"/>
                                                            <RotateTransform Angle="-0.8"/>
                                                            <TranslateTransform Y="0"/>
                                                        </TransformGroup>
                                                    </Border.RenderTransform>
                                                    <Border.Effect>
                                                        <DropShadowEffect x:Name="NoteShadow" Color="Black" BlurRadius="12" ShadowDepth="4" Direction="310" Opacity="0.35"/>
                                                    </Border.Effect>
                                                    <Border.Triggers>
                                                        <EventTrigger RoutedEvent="MouseEnter">
                                                            <BeginStoryboard>
                                                                <Storyboard>
                                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)" To="1.04" Duration="0:0:0.16"/>
                                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)" To="1.04" Duration="0:0:0.16"/>
                                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(RotateTransform.Angle)" To="0" Duration="0:0:0.16"/>
                                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[2].(TranslateTransform.Y)" To="-6" Duration="0:0:0.16"/>
                                                                    <DoubleAnimation Storyboard.TargetName="NoteShadow" Storyboard.TargetProperty="BlurRadius" To="24" Duration="0:0:0.16"/>
                                                                    <DoubleAnimation Storyboard.TargetName="NoteShadow" Storyboard.TargetProperty="ShadowDepth" To="8" Duration="0:0:0.16"/>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </EventTrigger>
                                                        <EventTrigger RoutedEvent="MouseLeave">
                                                            <BeginStoryboard>
                                                                <Storyboard>
                                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.18"/>
                                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.18"/>
                                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(RotateTransform.Angle)" To="-0.8" Duration="0:0:0.18"/>
                                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[2].(TranslateTransform.Y)" To="0" Duration="0:0:0.18"/>
                                                                    <DoubleAnimation Storyboard.TargetName="NoteShadow" Storyboard.TargetProperty="BlurRadius" To="12" Duration="0:0:0.18"/>
                                                                    <DoubleAnimation Storyboard.TargetName="NoteShadow" Storyboard.TargetProperty="ShadowDepth" To="4" Duration="0:0:0.18"/>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </EventTrigger>
                                                    </Border.Triggers>

                                                    <Grid>
                                                        <DockPanel>
                                                            <!-- Üst Renk Seçici, Düzenleme ve Silme Çubuğu -->
                                                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                                    <Button Content="✏️" FontSize="11" Padding="4,0" Margin="0,0,2,0"
                                                                            Background="Transparent" Foreground="#333333" BorderThickness="0" Cursor="Hand"
                                                                            ToolTip="Notu Düzenle" Click="BtnEditNote_Click" Tag="{Binding}"/>
                                                                    <Button Content="✕" FontSize="11" FontWeight="Bold" Padding="4,0"
                                                                            Background="Transparent" Foreground="#333333" BorderThickness="0" Cursor="Hand"
                                                                            Click="BtnDeleteNote_Click" Tag="{Binding}"/>
                                                                </StackPanel>
                                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                    <Button Width="14" Height="14" Margin="0,0,4,0" Padding="0" Background="#FEF08A" BorderBrush="#66000000" BorderThickness="1" Cursor="Hand" Tag="#FEF08A" Click="BtnNoteColor_Click" ToolTip="Sarı"/>
                                                                    <Button Width="14" Height="14" Margin="0,0,4,0" Padding="0" Background="#BBF7D0" BorderBrush="#66000000" BorderThickness="1" Cursor="Hand" Tag="#BBF7D0" Click="BtnNoteColor_Click" ToolTip="Yeşil"/>
                                                                    <Button Width="14" Height="14" Margin="0,0,4,0" Padding="0" Background="#BAE6FD" BorderBrush="#66000000" BorderThickness="1" Cursor="Hand" Tag="#BAE6FD" Click="BtnNoteColor_Click" ToolTip="Mavi"/>
                                                                    <Button Width="14" Height="14" Margin="0,0,4,0" Padding="0" Background="#FBCFE8" BorderBrush="#66000000" BorderThickness="1" Cursor="Hand" Tag="#FBCFE8" Click="BtnNoteColor_Click" ToolTip="Pembe"/>
                                                                    <Button Width="14" Height="14" Margin="0,0,4,0" Padding="0" Background="#DDD6FE" BorderBrush="#66000000" BorderThickness="1" Cursor="Hand" Tag="#DDD6FE" Click="BtnNoteColor_Click" ToolTip="Lavanta"/>
                                                                </StackPanel>
                                                            </DockPanel>
                                                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="158" Padding="0,0,4,0">
                                                                <ScrollViewer.Resources>
                                                                    <Style TargetType="ScrollBar">
                                                                        <Setter Property="Width" Value="5"/>
                                                                        <Setter Property="MinWidth" Value="5"/>
                                                                        <Setter Property="Background" Value="Transparent"/>
                                                                        <Setter Property="Template">
                                                                            <Setter.Value>
                                                                                <ControlTemplate TargetType="ScrollBar">
                                                                                    <Track x:Name="PART_Track" IsDirectionReversed="True">
                                                                                        <Track.Thumb>
                                                                                            <Thumb Cursor="Hand">
                                                                                                <Thumb.Template>
                                                                                                    <ControlTemplate TargetType="Thumb">
                                                                                                        <Border CornerRadius="2.5" Background="#44000000"/>
                                                                                                    </ControlTemplate>
                                                                                                </Thumb.Template>
                                                                                            </Thumb>
                                                                                        </Track.Thumb>
                                                                                    </Track>
                                                                                </ControlTemplate>
                                                                            </Setter.Value>
                                                                        </Setter>
                                                                    </Style>
                                                                </ScrollViewer.Resources>
                                                                <TextBlock Text="{Binding Text}" Foreground="#1F2937" TextWrapping="Wrap" FontSize="12.5" FontWeight="Medium" LineHeight="18"/>
                                                            </ScrollViewer>
                                                        </DockPanel>

                                                        <!-- Sağ Alt 3D Kıvrık Kağıt Köşesi -->
                                                        <Polygon Points="0,16 16,0 16,16" Fill="#28000000" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-14,-14" IsHitTestVisible="False"/>
                                                    </Grid>
                                                </Border>

                                                <!-- Üst Yapışkan Bant Efekti -->
                                                <Border Width="54" Height="13" Background="#55FFFFFF" BorderBrush="#22000000" BorderThickness="1"
                                                        HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,-6,0,0" IsHitTestVisible="False">
                                                    <Border.RenderTransform>
                                                        <RotateTransform Angle="-2"/>
                                                    </Border.RenderTransform>
                                                </Border>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>

                <!-- CHROME TARZI GİZLİ MOD ANA SAYFASI -->
                <Grid x:Name="IncognitoHomeOverlay" Background="#16131C" Visibility="Collapsed">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="640" Margin="24">
                        <Border Width="76" Height="76" CornerRadius="38" Background="#2B2438" HorizontalAlignment="Center" Margin="0,0,0,16">
                            <TextBlock Text="🕶️" FontSize="36" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Gizli Moddasınız" FontSize="30" FontWeight="Bold" Foreground="#F3E8FF" HorizontalAlignment="Center"/>
                        <TextBlock Text="Artık gizli olarak gezinebilirsiniz. Bu cihazı kullanan diğer kişiler etkinliğinizi görmez." FontSize="13.5" Foreground="#C4B5FD" TextAlignment="Center" TextWrapping="Wrap" Margin="0,8,0,22"/>

                        <Border Background="#231E2E" BorderBrush="#7C3AED" BorderThickness="1" CornerRadius="12" Padding="6" Margin="0,0,0,22">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Gizli Ara" Padding="16,8" Background="#7C3AED" Foreground="White" BorderThickness="0" FontWeight="SemiBold" Cursor="Hand" Click="BtnIncognitoSearch_Click"/>
                                <TextBox x:Name="IncognitoSearchBox" Tag="Gizli sekmede arayın veya adres yazın..." Background="Transparent" Foreground="#F3E8FF" CaretBrush="#F3E8FF" BorderThickness="0" FontSize="14" Padding="10,6" VerticalContentAlignment="Center" KeyDown="IncognitoSearchBox_KeyDown"/>
                            </DockPanel>
                        </Border>

                        <Border Background="#1F1A29" BorderBrush="#3B3154" BorderThickness="1" CornerRadius="12" Padding="18">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Özel Tarayıcı şunları kaydetmez:" FontWeight="Bold" FontSize="12.5" Foreground="#E9D5FF" Margin="0,0,0,8"/>
                                    <TextBlock Text="• Tarama geçmişiniz" FontSize="12" Foreground="#A78BFA" Margin="0,2"/>
                                    <TextBlock Text="• Çerezler ve site verileri" FontSize="12" Foreground="#A78BFA" Margin="0,2"/>
                                    <TextBlock Text="• Formlara girilen bilgiler" FontSize="12" Foreground="#A78BFA" Margin="0,2"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Etkinliğiniz şunlara görünür kalabilir:" FontWeight="Bold" FontSize="12.5" Foreground="#E9D5FF" Margin="0,0,0,8"/>
                                    <TextBlock Text="• Ziyaret ettiğiniz web siteleri" FontSize="12" Foreground="#A78BFA" Margin="0,2"/>
                                    <TextBlock Text="• İşvereniniz veya okulunuz" FontSize="12" Foreground="#A78BFA" Margin="0,2"/>
                                    <TextBlock Text="• İnternet servis sağlayıcınız" FontSize="12" Foreground="#A78BFA" Margin="0,2"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- EZAN VAKTİ BİLDİRİM BALONU -->
                <Border x:Name="PrayerToast" Background="{DynamicResource BarBgBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="2" CornerRadius="10" Padding="14,10" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="20" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🕌" FontSize="22" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <StackPanel Margin="0,0,14,0">
                            <TextBlock x:Name="PrayerToastTitle" Text="Namaz Vakti Girdi" FontWeight="Bold" FontSize="13"/>
                            <TextBlock x:Name="PrayerToastDesc" Text="" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </StackPanel>
                        <Button Style="{StaticResource IconToolButton}" Content="✕" Click="BtnClosePrayerToast_Click"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- GEMİNİ ASİSTAN YAN PANELİ -->
            <Border x:Name="GeminiDrawer" Grid.Column="3" Width="430" Background="{DynamicResource BarBgBrush}" BorderBrush="{DynamicResource BorderBrushSubtle}" BorderThickness="1,0,0,0" Visibility="Collapsed">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Padding="10,8" BorderBrush="{DynamicResource BorderBrushSubtle}" BorderThickness="0,0,0,1">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource IconToolButton}" Content="✕" Click="BtnGeminiToggle_Click"/>
                            <TextBlock Text="✨ Gemini Asistan" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                        </DockPanel>
                    </Border>
                    <wv2:WebView2 x:Name="GeminiWebView"/>
                </DockPanel>
            </Border>

            <!-- SAĞDAN AÇILAN AYARLAR, ŞİFRE KASASI VE ARAÇLAR ÇEKMECESİ -->
            <Border x:Name="SettingsDrawer" Grid.Column="4" Width="370" Background="{DynamicResource BarBgBrush}" BorderBrush="{DynamicResource BorderBrushSubtle}" BorderThickness="1,0,0,0" Visibility="Collapsed">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,14">
                            <Button DockPanel.Dock="Right" Style="{StaticResource IconToolButton}" Content="✕" Click="BtnSettings_Click"/>
                            <TextBlock Text="⚙️ Ayarlar, Kasa &amp; Araçlar" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                        </DockPanel>

                        <TextBlock Text="Hızlı Araçlar" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,8"/>
                        <UniformGrid Columns="2" Margin="0,0,0,16">
                            <Button Style="{StaticResource GradientIconButton}" Margin="3" Padding="8,10" Click="BtnToggleTheme_Click">
                                <Button.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#475569" Offset="0"/>
                                        <GradientStop Color="#1E293B" Offset="1"/>
                                    </LinearGradientBrush>
                                </Button.Background>
                                <TextBlock Text="🌓 Tema Değiştir" Foreground="White" FontWeight="SemiBold" FontSize="12"/>
                            </Button>
                            <Button Style="{StaticResource GradientIconButton}" Margin="3" Padding="8,10" Click="BtnReaderMode_Click">
                                <Button.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#0EA5E9" Offset="0"/>
                                        <GradientStop Color="#2563EB" Offset="1"/>
                                    </LinearGradientBrush>
                                </Button.Background>
                                <TextBlock Text="📖 Okuma Modu" Foreground="White" FontWeight="SemiBold" FontSize="12"/>
                            </Button>
                            <Button Style="{StaticResource GradientIconButton}" Margin="3" Padding="8,10" Click="BtnScreenshot_Click">
                                <Button.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#10B981" Offset="0"/>
                                        <GradientStop Color="#059669" Offset="1"/>
                                    </LinearGradientBrush>
                                </Button.Background>
                                <TextBlock Text="📷 Ekran Görüntüsü" Foreground="White" FontWeight="SemiBold" FontSize="12"/>
                            </Button>
                            <Button Style="{StaticResource GradientIconButton}" Margin="3" Padding="8,10" Click="BtnNewIncognitoTab_Click">
                                <Button.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#7C3AED" Offset="0"/>
                                        <GradientStop Color="#4F46E5" Offset="1"/>
                                    </LinearGradientBrush>
                                </Button.Background>
                                <TextBlock Text="🕶️ Gizli Sekme Aç" Foreground="White" FontWeight="SemiBold" FontSize="12"/>
                            </Button>
                        </UniformGrid>

                        <TextBlock Text="🛡️ Gizlilik Kalkanı" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,8"/>
                        <CheckBox x:Name="ChkAdBlock" Content="Reklam ve Tracker Engelleyici" IsChecked="True" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,4" Checked="PrivacyCheck_Changed" Unchecked="PrivacyCheck_Changed"/>
                        <CheckBox x:Name="ChkFingerprint" Content="Parmak İzi (Fingerprint) Koruması" IsChecked="True" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,4" Checked="PrivacyCheck_Changed" Unchecked="PrivacyCheck_Changed"/>
                        <CheckBox x:Name="ChkBlockCookies" Content="Üçüncü Taraf / Tüm Çerezleri Engelle" IsChecked="False" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,4" Checked="PrivacyCheck_Changed" Unchecked="PrivacyCheck_Changed"/>
                        <CheckBox x:Name="ChkRememberTabs" Content="Kapanışta Sekmeleri Hatırla" IsChecked="True" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,4" Checked="PrivacyCheck_Changed" Unchecked="PrivacyCheck_Changed"/>
                        <CheckBox x:Name="ChkAutoSleepTabs" Content="Kullanılmayan Sekmeleri Uyut (RAM Tasarrufu)" IsChecked="True" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,4" Checked="PrivacyCheck_Changed" Unchecked="PrivacyCheck_Changed"/>
                        <CheckBox x:Name="ChkMinimizeToTray" Content="Kapatınca Sistem Tepsisinde Çalış (Arka Plan)" IsChecked="False" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,4" Checked="PrivacyCheck_Changed" Unchecked="PrivacyCheck_Changed"/>
                        <CheckBox x:Name="ChkRunOnStartup" Content="Windows Açılışında Başlat" IsChecked="False" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,4,0,14" Checked="ChkRunOnStartup_Changed" Unchecked="ChkRunOnStartup_Changed"/>

                        <!-- ŞİFRE KASASI -->
                        <StackPanel Margin="0,0,0,14">
                            <Button x:Name="BtnTogglePasswordVault" Cursor="Hand" BorderThickness="0" Padding="0" HorizontalContentAlignment="Stretch" Click="BtnTogglePasswordVault_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border CornerRadius="8" Padding="12,10">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="#0284C7" Offset="0"/>
                                                    <GradientStop Color="#00B37E" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                            <ContentPresenter/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Background="#33000000" CornerRadius="10" Padding="8,2" Margin="0,0,8,0">
                                            <TextBlock x:Name="PwdCountBadgeText" Text="0" Foreground="White" FontSize="11" FontWeight="Bold"/>
                                        </Border>
                                        <TextBlock x:Name="PwdVaultChevron" Text="▶" Foreground="White" FontSize="11" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Text="🔐 Kayıtlı Şifre Kasası" Foreground="White" FontWeight="Bold" FontSize="13.5" VerticalAlignment="Center"/>
                                </DockPanel>
                            </Button>

                            <StackPanel x:Name="PasswordVaultBody" Margin="0,10,0,0" Visibility="Collapsed">
                                <TextBox x:Name="PwdSearchBox" Padding="6,5" Margin="0,0,0,8" Background="{DynamicResource AppBgBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderBrushSubtle}" Tag="🔍 Sitede veya hesapta ara..." TextChanged="PwdSearchBox_TextChanged"/>

                                <TextBox x:Name="PwdSiteBox" Padding="6,5" Margin="0,0,0,6" Background="{DynamicResource AppBgBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderBrushSubtle}" Tag="Site (örn: github.com)"/>
                                <TextBox x:Name="PwdUserBox" Padding="6,5" Margin="0,0,0,6" Background="{DynamicResource AppBgBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderBrushSubtle}" Tag="Kullanıcı adı / E-posta"/>
                                <DockPanel Margin="0,0,0,8">
                                    <Button DockPanel.Dock="Right" Style="{StaticResource PillActionButton}" Content="🎲" ToolTip="16 Haneli Güçlü Şifre Üret" Click="BtnGeneratePwd_Click"/>
                                    <TextBox x:Name="PwdPassBox" Padding="6,5" Margin="0,0,6,0" Background="{DynamicResource AppBgBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderBrushSubtle}" Tag="Şifre"/>
                                </DockPanel>
                                <Button Content="Şifreyi Kasaya Kaydet" Background="{DynamicResource AccentBrush}" Foreground="White" BorderThickness="0" Padding="8,7" Margin="0,0,0,8" Cursor="Hand" Click="BtnAddPwd_Click"/>

                                <UniformGrid Columns="2" Margin="0,0,0,8">
                                    <Button Style="{StaticResource PillActionButton}" Margin="0,0,3,0" Padding="6,6" FontSize="11.5" Content="📥 Şifre Dışa Aktar" Click="BtnExportPasswords_Click" ToolTip="AES-256 Şifreli (.ozelpwd), Chrome CSV veya JSON"/>
                                    <Button Style="{StaticResource PillActionButton}" Margin="3,0,0,0" Padding="6,6" FontSize="11.5" Content="📤 Şifre İçe Aktar" Click="BtnImportPasswords_Click" ToolTip="Chrome/Edge CSV, Şifreli (.ozelpwd) veya JSON"/>
                                </UniformGrid>

                                <ItemsControl x:Name="PasswordsItemsControl">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource SurfaceBgBrush}" CornerRadius="6" Padding="8" Margin="0,0,0,6">
                                                <DockPanel>
                                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Button Style="{StaticResource IconToolButton}" Padding="5,3" Content="👁️" ToolTip="Şifreyi Göster / Gizle" Click="BtnTogglePwdVisibility_Click" Tag="{Binding}"/>
                                                        <Button Style="{StaticResource IconToolButton}" Padding="5,3" Content="✏️" ToolTip="Düzenle" Click="BtnEditPwd_Click" Tag="{Binding}"/>
                                                        <Button Style="{StaticResource IconToolButton}" Padding="5,3" Content="⚡" ToolTip="Aktif Sayfaya Doldur" Click="BtnAutofillPwd_Click" Tag="{Binding}"/>
                                                        <Button Style="{StaticResource IconToolButton}" Padding="5,3" Content="📋" ToolTip="Şifreyi Kopyala" Click="BtnCopyPwd_Click" Tag="{Binding}"/>
                                                        <Button Style="{StaticResource IconToolButton}" Padding="5,3" Content="✕" ToolTip="Sil" Click="BtnDeletePwd_Click" Tag="{Binding}"/>
                                                    </StackPanel>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Site}" FontWeight="Bold" FontSize="12"/>
                                                        <TextBlock Text="{Binding Username}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                        <TextBlock x:Name="PwdSecretText" FontSize="11.5" FontFamily="Consolas" Foreground="{DynamicResource AccentBrush}" Margin="0,2,0,0" Text="••••••••"/>
                                                    </StackPanel>
                                                </DockPanel>
                                            </Border>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsPasswordVisible}" Value="True">
                                                    <Setter TargetName="PwdSecretText" Property="Text" Value="{Binding Password}"/>
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>

                        <!-- VERİ YEDEKLEME -->
                        <TextBlock Text="📦 Veri Yedekleme" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                        <UniformGrid Columns="2" Margin="0,0,0,14">
                            <Button Style="{StaticResource GradientIconButton}" Margin="3" Padding="8,8" Click="BtnExportData_Click">
                                <Button.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#0891B2" Offset="0"/>
                                        <GradientStop Color="#0284C7" Offset="1"/>
                                    </LinearGradientBrush>
                                </Button.Background>
                                <TextBlock Text="📥 Dışa Aktar" Foreground="White" FontWeight="SemiBold" FontSize="12"/>
                            </Button>
                            <Button Style="{StaticResource GradientIconButton}" Margin="3" Padding="8,8" Click="BtnImportData_Click">
                                <Button.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#6366F1" Offset="0"/>
                                        <GradientStop Color="#8B5CF6" Offset="1"/>
                                    </LinearGradientBrush>
                                </Button.Background>
                                <TextBlock Text="📤 İçe Aktar" Foreground="White" FontWeight="SemiBold" FontSize="12"/>
                            </Button>
                        </UniformGrid>

                        <TextBlock Text="🧹 Geçmişi Temizle" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                        <DockPanel Margin="0,0,0,12">
                            <Button DockPanel.Dock="Right" Style="{StaticResource GradientIconButton}" Padding="14,6" Margin="6,0,0,0" Click="BtnClearHistoryRange_Click">
                                <Button.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#F59E0B" Offset="0"/>
                                        <GradientStop Color="#EA580C" Offset="1"/>
                                    </LinearGradientBrush>
                                </Button.Background>
                                <TextBlock Text="Temizle" Foreground="White" FontWeight="Bold" FontSize="12"/>
                            </Button>
                            <ComboBox x:Name="ClearHistoryRangeCombo" SelectedIndex="0" Padding="6,5">
                                <ComboBoxItem Content="Son 1 Saat" Tag="1h"/>
                                <ComboBoxItem Content="Son 1 Gün" Tag="1d"/>
                                <ComboBoxItem Content="Son 1 Hafta" Tag="7d"/>
                                <ComboBoxItem Content="Komple Temizle" Tag="all"/>
                            </ComboBox>
                        </DockPanel>

                        <Button Style="{StaticResource GradientIconButton}" Padding="10,10" Margin="0,0,0,8" Click="BtnClearData_Click">
                            <Button.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#DC2626" Offset="0"/>
                                    <GradientStop Color="#EA580C" Offset="1"/>
                                </LinearGradientBrush>
                            </Button.Background>
                            <TextBlock Text="🔥 Tüm Tarama Verilerini Temizle" Foreground="White" FontWeight="Bold" FontSize="12"/>
                        </Button>
                        <Button Style="{StaticResource GradientIconButton}" Padding="10,9" Margin="0,0,0,14" Click="BtnCreateShortcuts_Click">
                            <Button.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#0284C7" Offset="0"/>
                                    <GradientStop Color="#4F46E5" Offset="1"/>
                                </LinearGradientBrush>
                            </Button.Background>
                            <TextBlock Text="🖥️ Masaüstü &amp; Başlat Kısayolu Oluştur" Foreground="White" FontWeight="SemiBold" FontSize="12"/>
                        </Button>

                        <Border Background="{DynamicResource SurfaceBgBrush}" BorderBrush="{DynamicResource BorderBrushSubtle}" BorderThickness="1" CornerRadius="10" Padding="12">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,8">
                                    <Border DockPanel.Dock="Right" Background="#2200B37E" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" CornerRadius="8" Padding="8,2" Margin="8,0,0,0">
                                        <TextBlock x:Name="MemoryUsageText" Text="-- MB" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="⚡ Sistem &amp; Bellek" FontWeight="Bold" FontSize="12.5" VerticalAlignment="Center"/>
                                </DockPanel>

                                <Button Cursor="Hand" BorderThickness="0" Padding="0" Margin="0,4,0,0" Click="BtnOptimizeRam_Click">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border CornerRadius="8" Padding="12,10">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                        <GradientStop Color="#7C3AED" Offset="0"/>
                                                        <GradientStop Color="#EC4899" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                                <TextBlock Text="🚀 RAM Temizle &amp; Performansı Artır" Foreground="White" FontWeight="Bold" FontSize="12.5" HorizontalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>

                                <TextBlock x:Name="MemoryCleanResultText" Text="" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,8,0,0" Visibility="Collapsed"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- GEÇMİŞ & İNDİRMELER ÇEKMECESİ (Ctrl+H / Ctrl+J) -->
            <Border x:Name="HistoryDownloadsDrawer" Grid.Column="5" Width="380" Background="{DynamicResource BarBgBrush}" BorderBrush="{DynamicResource BorderBrushSubtle}" BorderThickness="1,0,0,0" Visibility="Collapsed">
                <DockPanel Margin="14">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                        <Button DockPanel.Dock="Right" Style="{StaticResource IconToolButton}" Content="✕" Click="BtnCloseHistoryDrawer_Click"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource PillActionButton}" Content="📜 Geçmiş" Margin="0,0,6,0" Click="BtnSwitchToHistoryTab_Click"/>
                            <Button Style="{StaticResource PillActionButton}" Content="📥 İndirmeler" Click="BtnSwitchToDownloadsTab_Click"/>
                        </StackPanel>
                    </DockPanel>

                    <!-- Geçmiş Görünümü -->
                    <DockPanel x:Name="HistoryPanel">
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                            <Button DockPanel.Dock="Right" Content="Temizle" Padding="10,5" Margin="6,0,0,0" Background="#B91C1C" Foreground="White" BorderThickness="0" Cursor="Hand" Click="BtnClearHistory_Click"/>
                            <TextBox x:Name="HistorySearchBox" Tag="Geçmişte ara..." Padding="8,6" Background="{DynamicResource AppBgBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderBrushSubtle}" TextChanged="HistorySearchBox_TextChanged"/>
                        </DockPanel>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="HistoryItemsControl">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource SurfaceBgBrush}" CornerRadius="6" Padding="9,7" Margin="0,0,0,6" Cursor="Hand" MouseLeftButtonDown="HistoryItem_Click" Tag="{Binding}">
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding VisitedAt, StringFormat='{}{0:dd.MM HH:mm}'}" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding Url}" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>

                    <!-- İndirmeler Görünümü -->
                    <DockPanel x:Name="DownloadsPanel" Visibility="Collapsed">
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                            <Button DockPanel.Dock="Right" Style="{StaticResource PillActionButton}" Content="Temizle" Click="BtnClearDownloadsList_Click"/>
                            <Button Style="{StaticResource PillActionButton}" Content="📁 İndirilenler Klasörünü Aç" HorizontalAlignment="Left" Click="BtnOpenDownloadsRoot_Click"/>
                        </DockPanel>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="DownloadsItemsControl">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource SurfaceBgBrush}" CornerRadius="6" Padding="9,7" Margin="0,0,0,6">
                                            <DockPanel>
                                                <Button DockPanel.Dock="Right" Style="{StaticResource IconToolButton}" Content="📁" ToolTip="Klasörde Göster" Click="BtnRevealDownloadItem_Click" Tag="{Binding}"/>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding DownloadedAt, StringFormat='{}{0:dd.MM.yyyy HH:mm}'}" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </DockPanel>
            </Border>
        </Grid>

        <!-- GRUP OLUŞTURMA MODALI -->
        <Grid x:Name="GroupModalOverlay" Grid.RowSpan="4" Background="#AA000000" Visibility="Collapsed">
            <Border Background="{DynamicResource BarBgBrush}" BorderBrush="{DynamicResource BorderBrushSubtle}" BorderThickness="1" CornerRadius="10" Width="360" Padding="18" VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel>
                    <DockPanel Margin="0,0,0,12">
                        <Button DockPanel.Dock="Right" Style="{StaticResource IconToolButton}" Content="✕" Click="BtnCloseGroupModal_Click"/>
                        <TextBlock x:Name="GroupModalTitleText" Text="Yeni Çalışma Grubu" FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/>
                    </DockPanel>
                    <TextBlock Text="Grup Adı:" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                    <TextBox x:Name="GroupNameTextBox" Tag="Örn: Proje X, Finans, Müzik..." Background="{DynamicResource AppBgBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderBrushSubtle}" Padding="8,6" Margin="0,0,0,12"/>
                    <TextBlock Text="Renk Seçin:" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                    <UniformGrid Columns="6" Margin="0,0,0,14">
                        <Button Width="36" Height="28" Margin="3" Background="#00B37E" BorderBrush="White" BorderThickness="1" Cursor="Hand" Tag="#00B37E" Click="BtnPickGroupColor_Click" ToolTip="Zümrüt"/>
                        <Button Width="36" Height="28" Margin="3" Background="#0284C7" BorderBrush="White" BorderThickness="1" Cursor="Hand" Tag="#0284C7" Click="BtnPickGroupColor_Click" ToolTip="Okyanus"/>
                        <Button Width="36" Height="28" Margin="3" Background="#4F46E5" BorderBrush="White" BorderThickness="1" Cursor="Hand" Tag="#4F46E5" Click="BtnPickGroupColor_Click" ToolTip="İndigo"/>
                        <Button Width="36" Height="28" Margin="3" Background="#7C3AED" BorderBrush="White" BorderThickness="1" Cursor="Hand" Tag="#7C3AED" Click="BtnPickGroupColor_Click" ToolTip="Mor"/>
                        <Button Width="36" Height="28" Margin="3" Background="#DB2777" BorderBrush="White" BorderThickness="1" Cursor="Hand" Tag="#DB2777" Click="BtnPickGroupColor_Click" ToolTip="Pembe"/>
                        <Button Width="36" Height="28" Margin="3" Background="#E11D48" BorderBrush="White" BorderThickness="1" Cursor="Hand" Tag="#E11D48" Click="BtnPickGroupColor_Click" ToolTip="Kırmızı"/>
                        <Button Width="36" Height="28" Margin="3" Background="#EA580C" BorderBrush="White" BorderThickness="1" Cursor="Hand" Tag="#EA580C" Click="BtnPickGroupColor_Click" ToolTip="Turuncu"/>
                        <Button Width="36" Height="28" Margin="3" Background="#D97706" BorderBrush="White" BorderThickness="1" Cursor="Hand" Tag="#D97706" Click="BtnPickGroupColor_Click" ToolTip="Amber"/>
                        <Button Width="36" Height="28" Margin="3" Background="#CA8A04" BorderBrush="White" BorderThickness="1" Cursor="Hand" Tag="#CA8A04" Click="BtnPickGroupColor_Click" ToolTip="Altın"/>
                        <Button Width="36" Height="28" Margin="3" Background="#65A30D" BorderBrush="White" BorderThickness="1" Cursor="Hand" Tag="#65A30D" Click="BtnPickGroupColor_Click" ToolTip="Limon"/>
                        <Button Width="36" Height="28" Margin="3" Background="#0891B2" BorderBrush="White" BorderThickness="1" Cursor="Hand" Tag="#0891B2" Click="BtnPickGroupColor_Click" ToolTip="Camgöbeği"/>
                        <Button Width="36" Height="28" Margin="3" Background="#475569" BorderBrush="White" BorderThickness="1" Cursor="Hand" Tag="#475569" Click="BtnPickGroupColor_Click" ToolTip="Çelik"/>
                    </UniformGrid>
                    <Border x:Name="SelectedGroupColorPreview" Height="6" CornerRadius="3" Background="#00B37E" Margin="0,0,0,12"/>
                    <Button x:Name="BtnSaveGroup" Content="Kaydet" Background="{DynamicResource AccentBrush}" Foreground="White" BorderThickness="0" Padding="10,8" FontWeight="SemiBold" Cursor="Hand" Click="BtnSaveGroup_Click"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ŞEHİR & İLÇE SEÇİM MODALI -->
        <Grid x:Name="LocationModalOverlay" Grid.RowSpan="4" Background="#AA000000" Visibility="Collapsed">
            <Border Background="{DynamicResource BarBgBrush}" BorderBrush="{DynamicResource BorderBrushSubtle}" BorderThickness="1" CornerRadius="10" Width="400" Padding="18" VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel>
                    <DockPanel Margin="0,0,0,12">
                        <Button DockPanel.Dock="Right" Style="{StaticResource IconToolButton}" Content="✕" Click="BtnCloseLocationModal_Click"/>
                        <TextBlock Text="📍 Şehir &amp; İlçe Seçimi" FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/>
                    </DockPanel>
                    <Button Content="🎯 Mevcut Konumumu Otomatik Bul" Margin="0,0,0,10" Padding="10,8" Background="#0284C7" Foreground="White" BorderThickness="0" FontWeight="SemiBold" Cursor="Hand" Click="BtnAutoLocate_Click"/>
                    <DockPanel Margin="0,0,0,10">
                        <Button DockPanel.Dock="Right" Content="Ara" Padding="12,6" Background="{DynamicResource AccentBrush}" Foreground="White" BorderThickness="0" Cursor="Hand" Click="BtnSearchLocation_Click"/>
                        <TextBox x:Name="LocSearchBox" Tag="İl veya ilçe ara (örn: Ankara, Çankaya)..." Margin="0,0,6,0" Padding="8,6" Background="{DynamicResource AppBgBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderBrushSubtle}" KeyDown="LocSearchBox_KeyDown"/>
                    </DockPanel>
                    <ListBox x:Name="LocationResultsList" Height="180" Background="{DynamicResource AppBgBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderBrushSubtle}" MouseDoubleClick="LocationResultsList_DoubleClick"/>
                    <Button Content="Seçili Konumu Uygula" Margin="0,10,0,0" Padding="10,8" Background="{DynamicResource AccentBrush}" Foreground="White" BorderThickness="0" FontWeight="SemiBold" Cursor="Hand" Click="BtnApplySelectedLocation_Click"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ANA PAROLA MODALI (AES-256 ŞİFRELİ KASA AKTARIMI) -->
        <Grid x:Name="MasterPasswordModalOverlay" Grid.RowSpan="4" Background="#AA000000" Visibility="Collapsed">
            <Border Background="{DynamicResource BarBgBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1.5" CornerRadius="10" Width="380" Padding="18" VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel>
                    <DockPanel Margin="0,0,0,10">
                        <Button DockPanel.Dock="Right" Style="{StaticResource IconToolButton}" Content="✕" Click="BtnCancelMasterPwd_Click"/>
                        <TextBlock x:Name="MasterPwdTitleText" Text="🔐 Ana Parola" FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/>
                    </DockPanel>
                    <TextBlock x:Name="MasterPwdDescText" Text="Şifreli kasa dosyası için ana parolayı girin:" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                    <PasswordBox x:Name="MasterPwdBox" Padding="8,7" Background="{DynamicResource AppBgBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderBrushSubtle}" Margin="0,0,0,14" KeyDown="MasterPwdBox_KeyDown"/>
                    <Button Content="Onayla ve Devam Et" Padding="10,8" Background="{DynamicResource AccentBrush}" Foreground="White" BorderThickness="0" FontWeight="SemiBold" Cursor="Hand" Click="BtnConfirmMasterPwd_Click"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ŞİFRE DÜZENLEME MODALI -->
        <Grid x:Name="EditPasswordModalOverlay" Grid.RowSpan="4" Background="#AA000000" Visibility="Collapsed">
            <Border Background="{DynamicResource BarBgBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1.5" CornerRadius="10" Width="380" Padding="18" VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel>
                    <DockPanel Margin="0,0,0,12">
                        <Button DockPanel.Dock="Right" Style="{StaticResource IconToolButton}" Content="✕" Click="BtnCloseEditPwd_Click"/>
                        <TextBlock Text="✏️ Şifre Kaydını Düzenle" FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/>
                    </DockPanel>
                    <TextBlock Text="Site:" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                    <TextBox x:Name="EditPwdSiteBox" Tag="örn: github.com" Padding="8,6" Margin="0,0,0,10" Background="{DynamicResource AppBgBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderBrushSubtle}"/>
                    <TextBlock Text="Kullanıcı / E-posta:" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                    <TextBox x:Name="EditPwdUserBox" Tag="Kullanıcı adı veya e-posta" Padding="8,6" Margin="0,0,0,10" Background="{DynamicResource AppBgBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderBrushSubtle}"/>
                    <TextBlock Text="Şifre:" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                    <DockPanel Margin="0,0,0,14">
                        <Button DockPanel.Dock="Right" Style="{StaticResource PillActionButton}" Content="🎲" ToolTip="16 Haneli Güçlü Şifre Üret" Click="BtnGenerateEditPwd_Click"/>
                        <TextBox x:Name="EditPwdPassBox" Tag="Şifre" Padding="8,6" Margin="0,0,6,0" Background="{DynamicResource AppBgBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderBrushSubtle}"/>
                    </DockPanel>
                    <Button Content="Değişiklikleri Kaydet" Padding="10,8" Background="{DynamicResource AccentBrush}" Foreground="White" BorderThickness="0" FontWeight="SemiBold" Cursor="Hand" Click="BtnSaveEditPwd_Click"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- HIZLI KOMUT PALETİ (Ctrl+K) -->
        <Grid x:Name="CommandPaletteOverlay" Grid.RowSpan="4" Background="#AA000000" Visibility="Collapsed">
            <Border Background="{DynamicResource BarBgBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1.5" CornerRadius="12" Width="560" MaxHeight="440" Padding="14" VerticalAlignment="Top" Margin="0,90,0,0">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                        <Button DockPanel.Dock="Right" Style="{StaticResource IconToolButton}" Content="✕" Click="BtnCloseCommandPalette_Click"/>
                        <TextBox x:Name="CmdPaletteSearchBox" Tag="⌘ Sekme, yer imi, geçmiş veya komut ara (Ctrl+K)..." FontSize="14" Padding="10,8" Background="{DynamicResource AppBgBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderBrushSubtle}" TextChanged="CmdPaletteSearchBox_TextChanged" PreviewKeyDown="CmdPaletteSearchBox_PreviewKeyDown"/>
                    </DockPanel>
                    <ListBox x:Name="CmdPaletteResultsList"
                             ItemContainerStyle="{StaticResource SuggestionListBoxItemStyle}"
                             Background="Transparent"
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             BorderThickness="0"
                             MaxHeight="330"
                             MouseLeftButtonUp="CmdPaletteResultsList_MouseLeftButtonUp"/>
                </DockPanel>
            </Border>
        </Grid>

        <!-- ÇEVİRİ SONUÇ MODALI (Windows_Translate Entegrasyonu) -->
        <Grid x:Name="TranslateModalOverlay" Grid.RowSpan="4" Background="#AA000000" Visibility="Collapsed">
            <Border Background="{DynamicResource BarBgBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1.5" CornerRadius="12" Width="520" MaxHeight="480" Padding="18" VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel>
                    <DockPanel Margin="0,0,0,10">
                        <Button DockPanel.Dock="Right" Style="{StaticResource IconToolButton}" Content="✕" Click="BtnCloseTranslateModal_Click"/>
                        <TextBlock x:Name="TranslateHeaderText" Text="🌐 Çeviri Sonucu" FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/>
                    </DockPanel>
                    <TextBlock Text="Orijinal Metin:" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                    <TextBox x:Name="TranslateSourceBox" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="110" VerticalScrollBarVisibility="Auto" Padding="8,6" Background="{DynamicResource AppBgBrush}" Foreground="{DynamicResource TextSecondaryBrush}" BorderBrush="{DynamicResource BorderBrushSubtle}" Margin="0,0,0,10"/>
                    <TextBlock x:Name="TranslateTargetLabel" Text="Çeviri:" FontSize="11" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBox x:Name="TranslateResultBox" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="170" VerticalScrollBarVisibility="Auto" Padding="10,8" FontSize="13.5" Background="{DynamicResource SurfaceBgBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource AccentBrush}" Margin="0,0,0,14"/>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="📋 Çeviriyi Kopyala" Padding="12,7" Background="{DynamicResource AccentBrush}" Foreground="White" BorderThickness="0" FontWeight="SemiBold" Cursor="Hand" Click="BtnCopyTranslation_Click"/>
                        <Button HorizontalAlignment="Left" Style="{StaticResource PillActionButton}" Content="🔄 İngilizce ↔ Türkçe" Click="BtnSwapTranslateLang_Click"/>
                    </DockPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- QR KOD MODALI -->
        <Grid x:Name="QrModalOverlay" Grid.RowSpan="4" Background="#AA000000" Visibility="Collapsed">
            <Border Background="{DynamicResource BarBgBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1.5" CornerRadius="12" Width="340" Padding="18" VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel>
                    <DockPanel Margin="0,0,0,10">
                        <Button DockPanel.Dock="Right" Style="{StaticResource IconToolButton}" Content="✕" Click="BtnCloseQrModal_Click"/>
                        <TextBlock Text="📱 Sayfa QR Kodu" FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/>
                    </DockPanel>
                    <Border Background="White" CornerRadius="10" Padding="12" HorizontalAlignment="Center" Margin="0,4,0,10">
                        <Image x:Name="QrCodeImage" Width="210" Height="210" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                    </Border>
                    <TextBlock x:Name="QrUrlText" Text="" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                    <Button Content="📥 QR Kodu PNG Olarak Kaydet" Padding="10,8" Background="{DynamicResource AccentBrush}" Foreground="White" BorderThickness="0" FontWeight="SemiBold" Cursor="Hand" Click="BtnSaveQrPng_Click"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- SOL BARA YENİ UYGULAMA EKLEME MODALI -->
        <Grid x:Name="AddSidebarAppModalOverlay" Grid.RowSpan="4" Background="#AA000000" Visibility="Collapsed">
            <Border Background="{DynamicResource BarBgBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1.5" CornerRadius="12" Width="360" Padding="18" VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel>
                    <DockPanel Margin="0,0,0,12">
                        <Button DockPanel.Dock="Right" Style="{StaticResource IconToolButton}" Content="✕" Click="BtnCloseAddSidebarApp_Click"/>
                        <TextBlock Text="➕ Yan Bara Uygulama Ekle" FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/>
                    </DockPanel>
                    <TextBlock Text="Simge (Emoji):" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                    <TextBox x:Name="SidebarAppIconBox" Tag="Örn: 💬, 📺, 📧, 🤖" Text="🌐" Padding="8,6" Margin="0,0,0,10" Background="{DynamicResource AppBgBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderBrushSubtle}"/>
                    <TextBlock Text="Uygulama Adı:" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                    <TextBox x:Name="SidebarAppNameBox" Tag="Örn: Discord, Instagram, ChatGPT" Padding="8,6" Margin="0,0,0,10" Background="{DynamicResource AppBgBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderBrushSubtle}"/>
                    <TextBlock Text="URL Adresi:" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                    <TextBox x:Name="SidebarAppUrlBox" Tag="https://..." Padding="8,6" Margin="0,0,0,14" Background="{DynamicResource AppBgBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderBrushSubtle}"/>
                    <Button Content="Yan Bara Ekle" Padding="10,8" Background="{DynamicResource AccentBrush}" Foreground="White" BorderThickness="0" FontWeight="SemiBold" Cursor="Hand" Click="BtnSaveSidebarApp_Click"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- YAPIŞKAN NOT DÜZENLEME MODALI -->
        <Grid x:Name="EditNoteModalOverlay" Grid.RowSpan="4" Background="#AA000000" Visibility="Collapsed">
            <Border Background="{DynamicResource BarBgBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1.5" CornerRadius="12" Width="400" Padding="18" VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel>
                    <DockPanel Margin="0,0,0,12">
                        <Button DockPanel.Dock="Right" Style="{StaticResource IconToolButton}" Content="✕" Click="BtnCloseEditNote_Click"/>
                        <TextBlock Text="✏️ Yapışkan Notu Düzenle" FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/>
                    </DockPanel>
                    <TextBox x:Name="EditNoteTextBox" Tag="Not içeriğini yazın..." AcceptsReturn="True" TextWrapping="Wrap" Height="130" VerticalScrollBarVisibility="Auto" Padding="10,8" Background="{DynamicResource AppBgBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderBrushSubtle}" Margin="0,0,0,14"/>
                    <Button Content="Değişiklikleri Kaydet" Padding="10,8" Background="{DynamicResource AccentBrush}" Foreground="White" BorderThickness="0" FontWeight="SemiBold" Cursor="Hand" Click="BtnSaveEditNote_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
